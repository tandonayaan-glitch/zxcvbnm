rules_version = '2';

// ==================================================================
// CricketHub Firestore security rules
//  - Public read for cricket data (players, teams, tournaments,
//    matches, deliveries, stats, standings) so the viewer site works
//    without login.
//  - Writes restricted by role stored on the user's profile doc.
//  - Users can create their own profile + username lookup at signup.
// ==================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(roles) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().role in roles;
    }

    // Reserved master-admin username — MUST match VITE_MASTER_ADMIN_USERNAME.
    function masterUsername() {
      return 'ayaan';
    }

    function isMasterAdmin() {
      return hasRole(['MASTER_ADMIN']);
    }

    function isAdmin() {
      return hasRole(['MASTER_ADMIN', 'ADMIN']);
    }

    function canScore() {
      return hasRole(['MASTER_ADMIN', 'ADMIN', 'SCORER']);
    }

    function canManage() {
      return hasRole(['MASTER_ADMIN', 'ADMIN', 'TEAM_MANAGER', 'TOURNAMENT_MANAGER']);
    }

    // Master admin always, or the row's owner.
    function isOwnerOrMaster(ownerId) {
      return isMasterAdmin() || (isSignedIn() && ownerId == request.auth.uid);
    }

    // ---- Users -------------------------------------------------
    match /users/{uid} {
      allow read: if true; // profiles are needed for stats display
      // Self-signup may ONLY create a VIEWER, except the one-time master-admin
      // bootstrap (reserved username). ADMIN/SCORER are granted later by the
      // master admin via an update. An admin may also create a pending
      // account FOR someone else (the player-account-lifecycle flow) — always
      // VIEWER + pending_registration, never a role/status an admin could use
      // to hand themselves elevated access on another uid.
      allow create: if isSignedIn() && (
        (request.auth.uid == uid && (
          request.resource.data.role == 'VIEWER'
          || (request.resource.data.role == 'MASTER_ADMIN'
              && request.resource.data.username == masterUsername())
        ))
        || (isAdmin()
            && request.resource.data.role == 'VIEWER'
            && request.resource.data.status == 'pending_registration')
      );
      // Self may edit own profile but NOT change role or status, EXCEPT:
      //  - the one first-login activation transition (pending_registration -> active)
      //  - accepting an invitation: self-elevating to EXACTLY the role a still-valid
      //    `invitationRoleGrants/{uid}` doc names (see that collection's own comment for why
      //    this is safe rather than an open self-promotion hole — it's a narrow, unforgeable,
      //    per-user, per-role, time-boxed exception, not "any user can set role: ADMIN").
      // Role/ban changes otherwise require the master admin.
      allow update: if isSignedIn() && (
        (request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && (request.resource.data.status == resource.data.status
              || (resource.data.status == 'pending_registration'
                  && request.resource.data.status == 'active')))
        || (request.auth.uid == uid
            && request.resource.data.status == resource.data.status
            && exists(/databases/$(database)/documents/invitationRoleGrants/$(uid))
            && get(/databases/$(database)/documents/invitationRoleGrants/$(uid)).data.role == request.resource.data.role
            && get(/databases/$(database)/documents/invitationRoleGrants/$(uid)).data.expiresAt > request.time.toMillis())
        || isMasterAdmin()
      );
      allow delete: if isMasterAdmin();
    }

    // ---- Username lookup --------------------------------------
    match /usernameLookup/{username} {
      allow read: if true; // existence check for uniqueness / login
      // Created by the signing-up user, or by an admin creating a linked
      // account for someone else. Cannot overwrite an existing one.
      allow create: if isSignedIn()
        && (request.resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // ---- Players / Teams (owner-scoped) -----------------------
    match /players/{id} {
      allow read: if true;
      // Normal path: a manager creates/owns a player. Second path: a team invitation's own
      // invitee self-creates their own linked player doc — see the `teamInvitationGrants`
      // comment below for why this narrow, grant-gated exception is safe. The new player's
      // `ownerId` must match the actual team's owner (not an arbitrary value the invitee
      // picks), so accepting an invite can't be used to "own" an unrelated player doc.
      allow create: if (canManage()
          && (isMasterAdmin() || request.resource.data.ownerId == request.auth.uid))
        || (isSignedIn()
            && request.resource.data.linkedUserId == request.auth.uid
            && exists(/databases/$(database)/documents/teamInvitationGrants/$(request.auth.uid))
            && get(/databases/$(database)/documents/teamInvitationGrants/$(request.auth.uid)).data.teamId in request.resource.data.teamIds
            && get(/databases/$(database)/documents/teamInvitationGrants/$(request.auth.uid)).data.expiresAt > request.time.toMillis()
            && get(/databases/$(database)/documents/teams/$(get(/databases/$(database)/documents/teamInvitationGrants/$(request.auth.uid)).data.teamId)).data.ownerId == request.resource.data.ownerId);
      // Normal path: the owner/master edits any field. Second path: an invitee with an
      // existing linked player appends the newly-invited team to their own `teamIds` only —
      // nothing else on the doc may change, and only one id may be added.
      allow update: if isOwnerOrMaster(resource.data.ownerId)
        || (isSignedIn()
            && resource.data.linkedUserId == request.auth.uid
            && exists(/databases/$(database)/documents/teamInvitationGrants/$(request.auth.uid))
            && get(/databases/$(database)/documents/teamInvitationGrants/$(request.auth.uid)).data.expiresAt > request.time.toMillis()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teamIds', 'updatedAt'])
            && request.resource.data.teamIds.hasAll(resource.data.teamIds)
            && request.resource.data.teamIds.size() == resource.data.teamIds.size() + 1
            && request.resource.data.teamIds.hasAny([get(/databases/$(database)/documents/teamInvitationGrants/$(request.auth.uid)).data.teamId]));
      allow delete: if isOwnerOrMaster(resource.data.ownerId);
    }
    match /teams/{id} {
      allow read: if true;
      allow create: if canManage()
        && (isMasterAdmin() || request.resource.data.ownerId == request.auth.uid);
      // Normal path: the owner/master edits any field. Second path: a team invitation's own
      // invitee appends exactly the one player id they just joined as to `playerIds` — nothing
      // else on the team doc may change.
      allow update: if isOwnerOrMaster(resource.data.ownerId)
        || (isSignedIn()
            && exists(/databases/$(database)/documents/teamInvitationGrants/$(request.auth.uid))
            && get(/databases/$(database)/documents/teamInvitationGrants/$(request.auth.uid)).data.teamId == id
            && get(/databases/$(database)/documents/teamInvitationGrants/$(request.auth.uid)).data.expiresAt > request.time.toMillis()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playerIds', 'updatedAt'])
            && request.resource.data.playerIds.hasAll(resource.data.playerIds)
            && request.resource.data.playerIds.size() == resource.data.playerIds.size() + 1);
      allow delete: if isOwnerOrMaster(resource.data.ownerId);
    }

    // ---- Clubs / Seasons (owner-scoped) ------------------------
    match /clubs/{id} {
      allow read: if true;
      allow create: if canManage()
        && (isMasterAdmin() || request.resource.data.ownerId == request.auth.uid);
      allow update, delete: if isOwnerOrMaster(resource.data.ownerId);
    }
    match /seasons/{id} {
      allow read: if true;
      allow create: if canManage()
        && (isMasterAdmin() || request.resource.data.ownerId == request.auth.uid);
      allow update, delete: if isOwnerOrMaster(resource.data.ownerId);
    }

    // ---- Tournaments + standings (owner-scoped) ---------------
    match /tournaments/{id} {
      allow read: if true;
      allow create: if canManage()
        && (isMasterAdmin() || request.resource.data.ownerId == request.auth.uid);
      allow update, delete: if isOwnerOrMaster(resource.data.ownerId);
      match /standings/{rowId} {
        allow read: if true;
        allow write: if canScore();
      }
    }

    // ---- Matches + deliveries (owner-scoped) ------------------
    match /matches/{id} {
      allow read: if true;
      allow create: if canScore()
        && (isMasterAdmin() || request.resource.data.ownerId == request.auth.uid);
      allow update, delete: if isOwnerOrMaster(resource.data.ownerId);
      match /deliveries/{ballId} {
        allow read: if true;
        allow write: if canScore();
      }
      // Optional shot-zone/line-length tags — same access shape as
      // deliveries, but written separately from the scoring engine's batch.
      match /ballMeta/{ballId} {
        allow read: if true;
        allow write: if canScore();
      }
    }

    // ---- Cached stats -----------------------------------------
    match /playerStats/{id} {
      allow read: if true;
      allow write: if canScore();
    }
    match /teamStats/{id} {
      allow read: if true;
      allow write: if canScore();
    }

    // ---- Admin requests ---------------------------------------
    match /adminRequests/{uid} {
      // A user reads their own request; the master admin reads all.
      allow read: if isMasterAdmin()
        || (isSignedIn() && request.auth.uid == uid);
      // A signed-in user may create/replace only their own (pending) request.
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.status == 'pending';
      // Approve / reject / delete is master-admin only.
      allow update, delete: if isMasterAdmin();
    }

    // ---- Recovery attempts --------------------------------------
    match /recoveryAttempts/{id} {
      // The /recover flow runs pre-login (no auth yet), so logging an attempt
      // must be publicly writable — it only ever records a name/outcome, never
      // credentials. Only the master admin can read the trail back.
      allow read: if isMasterAdmin();
      allow create: if true;
      allow update, delete: if false;
    }

    // ---- Client error log ---------------------------------------
    match /clientErrors/{id} {
      // A render error can happen on any page, signed in or not, so logging
      // one must be publicly writable — it only ever records an error
      // message/stack/route, never user input or credentials. Only the
      // master admin can read the log back (Platform Tools diagnostics).
      allow read: if isMasterAdmin();
      allow create: if true;
      allow update, delete: if false;
    }

    // ---- Audit logs -------------------------------------------
    match /auditLogs/{id} {
      // Only the master admin reads the audit trail; any admin can append.
      allow read: if isMasterAdmin();
      allow create: if isAdmin()
        && request.resource.data.actorId == request.auth.uid;
      allow update, delete: if false;
    }

    // ---- App settings -----------------------------------------
    match /settings/{id} {
      allow read: if true;
      allow write: if isMasterAdmin();
    }

    // ---- Notifications ------------------------------------------
    match /notifications/{id} {
      // The recipient reads/marks their own; the master admin can too (support).
      allow read, update, delete: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isMasterAdmin());
      // Written by whichever client action triggers it (approving a request,
      // completing a match, merging a player) — always for someone other than
      // the writer, so this can't be scoped to "own uid only".
      allow create: if isSignedIn();
    }

    // ---- Activity feed --------------------------------------------
    match /activity/{id} {
      // Public read, like the rest of the cricket data — activity feeds are
      // meant to be visible on public club/team/player/tournament pages.
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // ---- Entity version history -----------------------------------
    match /entityVersions/{id} {
      // Public read, same tier as the entities themselves — an edit history
      // isn't sensitive, it's a diff of already-public player/team/etc fields.
      allow read: if true;
      // Only written as the side effect of an edit someone with manage rights
      // is already making; immutable once written (it's a historical record).
      allow create: if canManage();
      allow update, delete: if false;
    }

    // ---- Feature flags ----------------------------------------------
    match /featureFlags/{id} {
      // Public read — the client needs to evaluate flags for signed-out
      // viewers too (public-site gating), and a flag's on/off state isn't
      // sensitive. Only the master admin manages them.
      allow read: if true;
      allow write: if isMasterAdmin();
    }

    // ---- Invitations ------------------------------------------------
    match /invitations/{id} {
      // A single-doc read by its own id (the unguessable random code in the /invite/:code
      // link) is public — a signed-out visitor needs to preview who invited them and to what
      // role *before* they can sign in to respond (InvitePage's pending+signed-out state).
      // This doesn't expose anything beyond "if you already have the exact link" — it's not
      // enumerable, since `list` (the whole-collection reads InvitationsPage/listInvitations()
      // use) stays master-admin-only below.
      allow get: if true;
      allow list: if isMasterAdmin();
      // Granting a role via invitation is as sensitive as granting it
      // directly (Users & Roles), so creation/cancel/resend is master-only.
      allow create, delete: if isMasterAdmin();
      // The invited user may only flip their own still-pending invite to
      // accepted/declined — not touch its role or target. Master admin can
      // do anything (cancel/resend included, both just an update).
      allow update: if isSignedIn() && (
        isMasterAdmin()
        || (resource.data.invitedUid == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.role == resource.data.role
            && request.resource.data.invitedUid == resource.data.invitedUid)
      );
    }

    // ---- Invitation role-grant linkage (internal — see collections.ts comment) --------
    match /invitationRoleGrants/{uid} {
      // Nothing in the UI reads this directly — only firestore.rules itself (via `get()`,
      // which always has access regardless of a doc's own rules) needs to see it.
      allow read: if false;
      // Created/refreshed only alongside an invitation (createInvitation/resendInvitation),
      // both master-only actions.
      allow create, update: if isMasterAdmin();
      // Consumed (deleted) either by the master admin (cancelling) or by the invitee
      // themselves, as the mirror-image of accepting/declining their own invitation.
      allow delete: if isMasterAdmin() || (isSignedIn() && request.auth.uid == uid);
    }

    // ---- Team invitations (invite an existing user to join a team's roster) ----------
    match /teamInvitations/{id} {
      // Same shape as `invitations`: a single-doc read by its own unguessable code is public
      // (the invitee previews who invited them, and to which team, before signing in);
      // full-collection reads are scoped to whoever manages the referenced team.
      allow get: if true;
      allow list: if isMasterAdmin()
        || (isSignedIn() && isOwnerOrMaster(get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.ownerId));
      allow create: if isSignedIn()
        && isOwnerOrMaster(get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.ownerId)
        && request.resource.data.createdBy == request.auth.uid;
      allow delete: if isMasterAdmin()
        || (isSignedIn() && isOwnerOrMaster(get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.ownerId));
      // The invited user may only flip their own still-pending invite to accepted/declined —
      // not touch its team or target. The team's owner (or master) can do anything (cancel/
      // resend, both just an update).
      allow update: if isSignedIn() && (
        isMasterAdmin()
        || isOwnerOrMaster(get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.ownerId)
        || (resource.data.invitedUid == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.teamId == resource.data.teamId
            && request.resource.data.invitedUid == resource.data.invitedUid)
      );
    }

    // ---- Team invitation grant linkage (internal — see collections.ts comment) --------
    match /teamInvitationGrants/{uid} {
      // Nothing in the UI reads this directly — only firestore.rules itself (via `get()`,
      // which always has access regardless of a doc's own rules) needs to see it.
      allow read: if false;
      // Created/refreshed only alongside a team invitation, gated the same way as the
      // `teamInvitations` doc itself — whoever manages the referenced team.
      allow create, update: if isSignedIn()
        && isOwnerOrMaster(get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.ownerId);
      // Consumed (deleted) by the team's owner/master (cancelling), or by the invitee
      // themselves, as the mirror-image of accepting/declining their own invitation.
      allow delete: if isMasterAdmin()
        || (isSignedIn() && request.auth.uid == uid)
        || (isSignedIn() && exists(/databases/$(database)/documents/teams/$(resource.data.teamId))
            && isOwnerOrMaster(get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.ownerId));
    }
  }
}
