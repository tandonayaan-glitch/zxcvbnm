# ------------------------------------------------------------------
# Firebase configuration
# Copy this file to `.env.local` and fill in the values from your
# Firebase project: Project settings -> General -> Your apps -> SDK setup.
# All keys MUST be prefixed with VITE_ to be exposed to the client.
# ------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx

# Internal domain used to map usernames -> synthetic Firebase Auth emails.
# Users never see this; it just lets us use username/password UX on top of
# Firebase Auth (which requires an email). Keep it stable for a project.
VITE_AUTH_EMAIL_DOMAIN=crickethub.local

# ------------------------------------------------------------------
# Cloudflare R2 image storage (see worker/README.md for full setup)
# Neither of these is secret — they're just URLs the browser calls directly.
# All actual credentials (R2 access, Firestore writes) live only as Worker
# secrets, never here.
# ------------------------------------------------------------------
# The deployed crickethub-media-worker's URL (from `wrangler deploy`'s output).
VITE_R2_WORKER_URL=https://crickethub-media-worker.your-subdomain.workers.dev
# The R2 bucket's public read URL (from `wrangler r2 bucket dev-url enable`, or a
# custom domain once one is set up). Must match worker/wrangler.toml's R2_PUBLIC_BASE_URL.
VITE_R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
